<%- @page_title = @band.primary? ? t("taper.shows") : @band.name %>
<%- @page_description = @band.description.presence %>
<div class="taper-band">
  <h1><%= @band.primary? ? t("taper.shows") : @band.name %></h1>
  <%- if @band.description.present? %>
    <p class="taper-band__description"><%= @band.description %></p>
  <%- end %>

  <nav class="taper-band__years" aria-label="<%= t("taper.years") %>">
    <a href="<%= @band.url %>" class="<%= "is-active" if @year.nil? %>"><%= t("taper.all_years") %></a>
    <%- @years.each do |year, count| %>
      <a href="<%= @band.url %>?year=<%= year %>" class="<%= "is-active" if @year == year %>"><%= year %> <small><%= count %></small></a>
    <%- end %>
  </nav>

  <p class="taper-band__suggest"><a href="<%= (@band.primary? ? DiscourseTaper.root_path : @band.url) %>/suggest"><%= t("taper.suggest.missing_show") %></a></p>

  <%- if @shows.empty? %>
    <p class="taper-empty"><%= t("taper.no_shows") %></p>
  <%- else %>
    <%- @shows.group_by { |s| s.date.year }.each do |year, shows| %>
      <h2 class="taper-band__year"><%= year %></h2>
      <ul class="taper-show-list">
        <%- shows.each do |show| %>
          <li class="taper-show-list__item">
            <a class="taper-show-list__date" href="<%= show.url %>"><%= show.label %></a>
            <span class="taper-show-list__venue"><%= show.venue %><%- if show.city %>, <%= show.city %><%- end %></span>
            <%- if show.tour %><span class="taper-show-list__tour"><%= show.tour %></span><%- end %>
            <span class="taper-show-list__meta">
              <%- n = show.sources.size %>
              <%- if n > 0 %><%= t("taper.recordings_count", count: n) %><%- else %><%= t("taper.no_recordings") %><%- end %>
            </span>
          </li>
        <%- end %>
      </ul>
    <%- end %>
  <%- end %>
</div>
