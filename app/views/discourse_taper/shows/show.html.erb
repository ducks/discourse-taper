<%- @page_title = @show.title %>
<%- @page_description = [@show.location, @show.setlist_titles.first(6).join(", ").presence].compact.join(". ") %>
<%- @body_class = "taper-show-#{@show.id}" %>
<%- suggest_url = "#{@band.primary? ? DiscourseTaper.root_path : @band.url}/suggest?date=#{@show.slug}" %>
<article class="taper-wrap taper-show">
  <header class="taper-showhead">
    <nav class="taper-crumbs" aria-label="Breadcrumb">
      <a href="<%= DiscourseTaper.root_path %>"><%= t("taper.shows") %></a>
      <%- if !@band.primary? %><span aria-hidden="true">/</span><a href="<%= @band.url %>"><%= @band.name %></a><%- end %>
      <span aria-hidden="true">/</span>
      <a href="<%= @band.url %>?year=<%= @show.date.year %>"><%= @show.date.year %></a>
      <%- if @show.tour.present? %><span aria-hidden="true">/</span><a href="<%= @band.url %>?tour=<%= ERB::Util.url_encode(@show.tour) %>"><%= @show.tour %></a><%- end %>
    </nav>
    <h1 class="taper-display taper-showhead__date"><%= @show.label %></h1>
    <p class="taper-showhead__venue"><%= @show.venue %> <span><%= [@show.city, @show.region, @show.country].compact.join(", ") %></span></p>
    <div class="taper-facts">
      <%- if @runtime %><span><%= t("taper.runtime") %> <b><%= duration(@runtime) %></b></span><%- end %>
      <%- if @show.tour.present? %><span><%= t("taper.tour") %> <b><%= @show.tour %></b></span><%- end %>
      <span><%= t("taper.recordings").downcase %> <b><%= @sources.size %></b></span>
    </div>
  </header>

  <div class="taper-showbody">
    <section>
      <div class="taper-section-title"><h2><%= t("taper.setlist") %></h2><a href="<%= suggest_url %>"><%= t("taper.suggest_correction") %></a></div>
      <%- if @show.setlist.any? %>
        <ol class="taper-setlist">
          <%- @show.setlist.each do |song| %>
            <li class="<%= "is-tape" if song["notes"].to_s.include?("tape") %>">
              <span>
                <span class="taper-setlist__song"><%= song["title"] %></span>
                <%- if song["notes"].present? %><span class="taper-setlist__note"><%= song["notes"] %></span><%- end %>
              </span>
            </li>
          <%- end %>
        </ol>
      <%- else %>
        <p class="taper-empty"><%= t("taper.no_setlist") %></p>
      <%- end %>
      <%- if @show.notes.present? %>
        <p class="taper-show-notes"><%= @show.notes %></p>
      <%- end %>
    </section>

    <section>
      <div class="taper-section-title"><h2><%= t("taper.recordings") %></h2><a href="<%= suggest_url %>"><%= t("taper.suggest.recording_heading") %></a></div>
      <%- if @player %>
        <div class="taper-player">
          <iframe src="<%= embed_url(@player) %>" title="<%= @player.title.presence || t("taper.provider.#{@player.provider}") %>" allow="accelerometer; encrypted-media; picture-in-picture" allowfullscreen loading="lazy"></iframe>
        </div>
      <%- end %>
      <%- if @sources.any? %>
        <div class="taper-sources">
          <%- @sources.each do |source| %>
            <div class="taper-source"<%- if source == @player %> aria-current="true"<%- end %>>
              <span class="taper-source-mark" aria-hidden="true"><i></i><i></i><i></i></span>
              <span>
                <a class="taper-source__title" href="<%= DiscourseTaper.root_path %>/recordings/<%= source.id %>"><%= source.title.presence || t("taper.provider.#{source.provider}") %></a>
                <a class="taper-source__open" href="<%= source.display_url %>" rel="noopener">↗</a><br>
                <span class="taper-source__meta"><%= [t("taper.kind.#{source.kind}"), (%w[unknown video].include?(source.format) ? nil : source.format), duration(source.duration_seconds), t("taper.provider.#{source.provider}"), (source.credited_taper ? t("taper.taped_by", name: source.credited_taper) : t("taper.taper_unclaimed"))].compact.join(" · ") %></span>
                <%- if source.taper.nil? && current_user %>
                  <a class="taper-source__claim" href="<%= suggest_url %>&claim=<%= source.id %>"><%= t("taper.claim.link") %></a>
                <%- elsif source.taper %>
                  <a class="taper-source__claim taper-source__claim--done" href="<%= Discourse.base_path %>/u/<%= source.taper.username %>"><%= t("taper.claim.by", name: source.taper.username) %></a>
                <%- end %>
                <%- if source.lineage.present? %>
                  <details class="taper-source__lineage"><summary><%= t("taper.lineage") %></summary><%= source.lineage %></details>
                <%- end %>
              </span>
              <span class="taper-source__kind"><%= t("taper.kind.#{source.kind}") %></span>
            </div>
          <%- end %>
        </div>
      <%- else %>
        <p class="taper-empty"><%= t("taper.no_recordings_yet") %></p>
      <%- end %>
    </section>
  </div>

  <nav class="taper-neighbours" aria-label="<%= t("taper.neighbours") %>">
    <%- if @previous_show %>
      <a href="<%= @previous_show.url %>" rel="prev"><span class="taper-eyebrow"><%= t("taper.previous") %></span><span class="taper-mono"><%= @previous_show.label %></span><span><%= [@previous_show.venue, @previous_show.city].compact.join(", ") %></span></a>
    <%- end %>
    <%- if @next_show %>
      <a class="taper-neighbours__next" href="<%= @next_show.url %>" rel="next"><span class="taper-eyebrow"><%= t("taper.next") %></span><span class="taper-mono"><%= @next_show.label %></span><span><%= [@next_show.venue, @next_show.city].compact.join(", ") %></span></a>
    <%- end %>
  </nav>

  <section class="taper-discuss">
    <div class="taper-discuss__head"><h2><%= t("taper.from_the_community") %></h2><span class="taper-eyebrow"><%= @reply_count.zero? ? t("taper.no_replies") : t("taper.replies_count", count: @reply_count) %></span></div>
    <%- @replies.each do |post| %>
      <div class="taper-comment">
        <span class="taper-comment__avatar" aria-hidden="true"><%= post.user&.username.to_s.first(2) %></span>
        <div>
          <div class="taper-comment__who"><%= post.user&.username %> · <%= time_ago_in_words(post.created_at) %></div>
          <p><%= post.excerpt(220, strip_links: true, text_entities: true) %></p>
        </div>
      </div>
    <%- end %>
    <a class="taper-btn" href="<%= @show.topic.url %>"><span class="taper-mark" aria-hidden="true"></span> <%= @reply_count.zero? ? t("taper.discuss") : t("taper.join_discussion") %></a>
  </section>
</article>

<script type="application/ld+json">
<%= raw({
  "@context" => "https://schema.org",
  "@type" => "MusicEvent",
  "name" => @show.title,
  "startDate" => @show.date.iso8601,
  "performer" => { "@type" => "MusicGroup", "name" => @band.name },
  "location" => { "@type" => "Place", "name" => @show.venue, "address" => [@show.city, @show.region, @show.country].compact.join(", ").presence }.compact,
  "url" => "#{Discourse.base_url_no_prefix}#{@show.url}",
  "recordedIn" => @sources.map { |s| { "@type" => "MusicRecording", "name" => s.title.presence || s.provider, "url" => s.display_url }.compact },
}.compact.to_json) %>
</script>
