<!DOCTYPE html>
<html lang="<%= html_lang %>">
  <head>
    <meta charset="utf-8">
    <title><%= reader_title %></title>
    <%= render partial: "layouts/head" %>
    <%= render partial: "common/discourse_publish_stylesheet" %>
    <%= theme_lookup("head_tag") %>
    <link rel="alternate" type="application/json" href="<%= json_url %>">
    <meta name="description" content="<%= reader_description %>">
    <%- if @page_noindex || action_name == "suggest_form" %><meta name="robots" content="noindex,follow"><%- end %>
    <%= raw crawlable_meta_data(title: reader_title, description: reader_description, url: @canonical_url, image: reader_image) %>
    <%- reader_alternates.each do |link| %>
      <link rel="alternate" hreflang="<%= link[:locale] %>" href="<%= link[:url] %>">
    <%- end %>
    <script type="application/ld+json"><%= raw(ERB::Util.json_escape(reader_schema.to_json)) %></script>
    <%= render_google_tag_manager_head_code %>
    <%= render_google_universal_analytics_code %>
    <%= preload_script 'js/pageview' %>
  </head>
  <body class="taper <%= @body_class %>">
    <%= theme_lookup("body_tag") %>
    <header class="taper-top">
      <div class="taper-wrap taper-top__inner">
        <a class="taper-top__name" href="<%= DiscourseTaper.root_path %>"><span class="taper-mark" aria-hidden="true"></span><%= @primary_band&.name || SiteSetting.title %></a>
        <%- if @bands.size > 1 %>
          <nav class="taper-top__bands" aria-label="<%= t("taper.bands") %>">
            <%- @bands.each do |b| %>
              <a href="<%= b.url %>" class="<%= "is-active" if @band&.id == b.id %>"><%= b.name %></a>
            <%- end %>
          </nav>
        <%- end %>
        <%- if DiscourseTaper.reader_locales.size > 1 %>
          <nav class="taper-top__lang" aria-label="<%= t("taper.language") %>">
            <%- locale_links.each do |link| %>
              <a href="<%= link[:url] %>" hreflang="<%= link[:locale] %>"<%- if link[:current] %> aria-current="true"<%- end %>><%= link[:locale].upcase %></a>
            <%- end %>
          </nav>
        <%- end %>
        <a class="taper-top__forum" href="<%= forum_url %>"><%= SiteSetting.title %></a>
      </div>
    </header>
    <main class="taper-main">
      <%= yield %>
    </main>
    <footer class="taper-footer">
      <div class="taper-wrap">
        <a href="<%= forum_url %>"><%= SiteSetting.title %></a>
        <a href="<%= (@band&.primary? || @band.nil?) ? "#{DiscourseTaper.root_path}/suggest" : "#{@band.url}/suggest" %>"><%= t("taper.suggest.missing_show") %></a>
      </div>
    </footer>
  </body>
</html>
